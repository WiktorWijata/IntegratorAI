<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet -->
    <PackageId>IntegratorAI.Api.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Authors>WiktorWijata</Authors>
    <Description>Contract models, DTOs and Refit client interfaces for the IntegratorAI API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/WiktorWijata/IntegratorAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>integrator;ai;contracts;refit</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Refit" Version="8.0.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
